generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  WRITER
  ADMIN
}

enum PostType {
  INFO
  ARTICLE
  ACTU
  ANNONCE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentReactionType {
  LIKE
  DISLIKE
}

enum ModerationAction {
  AUTO_DELETE
  FLAG_FOR_REVIEW
}

enum ModerationLogType {
  AUTO_DELETED
  FLAGGED
  APPROVED
  REJECTED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  nom       String
  prenom    String
  username  String    @unique
  classe    String
  role      Role      @default(USER)
  bio       String?
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  posts             Post[]
  comments          Comment[]
  likes             Like[]
  commentReactions  CommentReaction[]
  visitLogs         VisitLog[]
  moderationKeywords ModerationKeyword[] @relation("KeywordCreator")
  moderationLogsAsModerator ModerationLog[] @relation("ModerationModerator")
  auditLogs         AuditLog[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model Post {
  id          String     @id @default(cuid())
  type        PostType
  title       String
  slug        String     @unique
  content     String?    @db.Text
  summary     String
  thumbnail   String?
  mediaUrl    String?
  images      String[]   @default([])
  authorId    String
  views       Int        @default(0)
  status      PostStatus @default(DRAFT)
  tags        String[]
  info        String?
  expiresAt   DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       Like[]
  postViews   PostView[]

  @@index([slug])
  @@index([authorId])
  @@index([type])
  @@index([status])
  @@index([publishedAt])
  @@index([expiresAt])
}

model Comment {
  id             String   @id @default(cuid())
  postId         String
  userId         String
  parentId       String?
  content        String
  isHidden       Boolean  @default(false)
  isFlagged      Boolean  @default(false)
  flaggedKeyword String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([isHidden])
  @@index([isFlagged])
}

model CommentReaction {
  id        String              @id @default(cuid())
  commentId String
  userId    String
  type      CommentReactionType
  createdAt DateTime            @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  ipAddress String?
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([postId, ipAddress])
  @@index([postId])
  @@index([userId])
}

/// Visites site-wide (toutes les pages), distinct de PostView qui ne
/// compte que les vues d'un post précis. Sert au dashboard de stats
/// (journalière, hebdomadaire, mensuelle, trimestrielle, semestrielle, annuelle).
model VisitLog {
  id        String   @id @default(cuid())
  path      String
  sessionId String
  userId    String?
  referrer  String?
  device    String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([path])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

/// Liste des mots-clés/phrases surveillés pour la modération automatique
/// des commentaires. AUTO_DELETE = supprimé silencieusement à la création.
/// FLAG_FOR_REVIEW = masqué et mis en file d'attente pour un modérateur.
model ModerationKeyword {
  id        String            @id @default(cuid())
  phrase    String            @unique
  action    ModerationAction  @default(AUTO_DELETE)
  isActive  Boolean           @default(true)
  createdBy String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  creator User? @relation("KeywordCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([isActive])
}

/// Trace de toute action de modération automatique ou manuelle, pour
/// audit et pour pouvoir contester/annuler un faux positif.
model ModerationLog {
  id             String            @id @default(cuid())
  type           ModerationLogType
  content        String            @db.Text
  matchedKeyword String?
  authorId       String?
  postId         String?
  moderatorId    String?
  createdAt      DateTime          @default(now())

  moderator User? @relation("ModerationModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([authorId])
  @@index([postId])
  @@index([createdAt])
}

/// Journal des actions admin (suppression de post, changement de statut,
/// changement de rôle, suppression de commentaire, etc.) pour traçabilité.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  Role
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model AccessKey {
  id        String    @id @default(cuid())
  key       String    @unique
  role      Role
  isUsed    Boolean   @default(false)
  usedBy    String?
  usedAt    DateTime?
  createdBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([role])
  @@index([isUsed])
}